#!/usr/bin/env bash
if ((BASH_VERSINFO[0] < 5)); then
  echo "needs bash 5+, found $BASH_VERSION" >&2
  exit 1
fi
set -euo pipefail

# Load every profile in contract/profiles (admin.load_profile) and every
# latency bucket version in contract/latency (admin.load_latency_buckets)
# into the store's catalog, in one transaction, as the database owner. Prints
# each version as new or already loaded; a loaded version whose file now says
# otherwise stops the run and loads nothing. Without --apply, nothing is kept.
#   bin/load-profiles postgres://postgres:...@host:5432/minnalavu?sslmode=... --apply
usage="usage: bin/load-profiles <database-url> [--apply]"

if (($# < 1 || $# > 2)) || { (($# == 2)) && [[ $2 != --apply ]]; }; then
  printf '%s\n' "$usage" >&2
  exit 2
fi

url=$1
root=$(cd "$(dirname "$0")/../.." && pwd -P)
shopt -s nullglob
files=("$root"/contract/profiles/*.json)
if ((${#files[@]} == 0)); then
  printf 'no profiles in %s/contract/profiles\n' "$root" >&2
  exit 1
fi
buckets=("$root"/contract/latency/buckets.v*.json)
if ((${#buckets[@]} == 0)); then
  printf 'no latency bucket versions in %s/contract/latency\n' "$root" >&2
  exit 1
fi

end=ROLLBACK
if (($# == 2)); then
  end=COMMIT
fi

# Each file goes to psql as a variable, which :'docN' quotes as a literal.
vars=()
sql=("BEGIN;")
for i in "${!files[@]}"; do
  vars+=(-v "doc$i=$(<"${files[$i]}")")
  sql+=("SELECT format('%s version %s: %s', d ->> 'profile', d -> 'version', admin.load_profile(d))
         FROM (SELECT :'doc$i'::jsonb AS d) f;")
done
for i in "${!buckets[@]}"; do
  vars+=(-v "buckets$i=$(<"${buckets[$i]}")")
  sql+=("SELECT format('latency buckets version %s: %s', d -> 'version', admin.load_latency_buckets(d))
         FROM (SELECT :'buckets$i'::jsonb AS d) f;")
done
sql+=("$end;")

printf '%s\n' "${sql[@]}" | psql "$url" -X -q -At -v ON_ERROR_STOP=1 "${vars[@]}"
if [[ $end == ROLLBACK ]]; then
  printf 'dry run: nothing loaded; add --apply to load\n' >&2
fi

#!/usr/bin/env bash
if ((BASH_VERSINFO[0] < 5)); then
  echo "needs bash 5+, found $BASH_VERSION" >&2
  exit 1
fi
set -euo pipefail

# Mail the operator when the problems in health.problems change: one mail
# when any problem appears or clears, listing every problem open; none while
# they stay as last reported. Run by cron on the VPS (central/README.md).
#   bin/alert            # print the mail it would send; send nothing, keep no state
#   bin/alert --apply    # send it, then remember what it reported
#
# If the health views cannot be read, that is a problem too
# (health_query_failed): mailed once, and the run exits 1.
#
# All required, from the environment:
#   ALERT_DB_URL          connection string, as a member of the role monitor
#   ALERT_SMTP_URL        smtps://host:465, or smtp://host:587 (STARTTLS)
#   ALERT_SMTP_TLS        required; or none, only for a mail catcher on this machine
#   ALERT_SMTP_USER       SMTP login
#   ALERT_SMTP_PASSWORD   (passed to curl on a pipe, not on the command line)
#   ALERT_FROM            the sender's address
#   ALERT_TO              recipients' addresses, separated by commas
#   ALERT_STATE_FILE      what was last reported (one "kind<TAB>subject" per
#                         line); its directory must exist
usage="usage: bin/alert [--apply]"

die() {
  printf 'bin/alert: %s\n' "$1" >&2
  exit 2
}

apply=false
case "$#:${1:-}" in
  0:) ;;
  1:--apply) apply=true ;;
  *)
    printf '%s\n' "$usage" >&2
    exit 2
    ;;
esac

required=(ALERT_DB_URL ALERT_SMTP_URL ALERT_SMTP_TLS ALERT_SMTP_USER ALERT_SMTP_PASSWORD
  ALERT_FROM ALERT_TO ALERT_STATE_FILE)
missing=()
for name in "${required[@]}"; do
  if [[ -z ${!name:-} ]]; then missing+=("$name"); fi
done
if ((${#missing[@]} > 0)); then
  die "not set: ${missing[*]} (each is described at the top of bin/alert)"
fi

address='^[^][[:space:][:cntrl:]<>(),;:@"]+@[^][[:space:][:cntrl:]<>(),;:@"]+$'
[[ $ALERT_SMTP_URL =~ ^smtps?://[^[:space:]]+$ ]] ||
  die "ALERT_SMTP_URL $ALERT_SMTP_URL: expected smtps://host:port or smtp://host:port"
[[ $ALERT_SMTP_TLS =~ ^(required|none)$ ]] ||
  die "ALERT_SMTP_TLS $ALERT_SMTP_TLS: expected required, or none for a local mail catcher"
[[ $ALERT_FROM =~ $address ]] || die "ALERT_FROM $ALERT_FROM: expected one address"
# read takes one line, and the To header the whole value: no line breaks.
[[ $ALERT_TO =~ ^[^[:space:][:cntrl:]]+$ ]] ||
  die "ALERT_TO: expected addresses separated by commas, with no spaces or line breaks"
IFS=, read -r -a to <<<"$ALERT_TO"
for r in "${to[@]}"; do
  [[ $r =~ $address ]] || die "ALERT_TO: $r is not an address (separate addresses by commas, no spaces)"
done
state=$ALERT_STATE_FILE
[[ -d $(dirname -- "$state") ]] || die "ALERT_STATE_FILE $state: its directory does not exist"

tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT

previous=""
if [[ -f $state ]]; then previous=$(<"$state"); fi

# Each problem now and each one last reported, as
# status<TAB>kind<TAB>subject<TAB>detail; status is new, open or cleared.
problems() {
  psql "$ALERT_DB_URL" -X -q -A -t -F $'\t' -v ON_ERROR_STOP=1 -v previous="$previous" <<'SQL'
WITH previous AS (
  SELECT split_part(line, E'\t', 1) AS kind, split_part(line, E'\t', 2) AS subject
  FROM unnest(string_to_array(:'previous', E'\n')) line
  WHERE line <> ''
), compared AS (
  SELECT CASE WHEN p.kind IS NULL THEN 'new' WHEN c.kind IS NULL THEN 'cleared' ELSE 'open' END
           AS status,
         coalesce(c.kind, p.kind) AS kind, coalesce(c.subject, p.subject) AS subject,
         coalesce(c.detail, '') AS detail
  FROM health.problems c
  FULL JOIN previous p ON p.kind = c.kind AND p.subject = c.subject
)
SELECT status, kind, subject, detail FROM compared
ORDER BY array_position(ARRAY['new', 'cleared', 'open'], status), kind, subject;
SQL
}

# Without the views, the last report stands, plus this failure.
unreadable() {
  local failure=$'health_query_failed\tbin/alert' status=new error
  if grep -qxF -- "$failure" <<<"$previous"; then status=open; fi
  error=$(tr -s '\n\t' '  ' <"$tmp/error")
  printf '%s\t%s\t%s\n' "$status" "$failure" "cannot read the health views: $error"
  awk -v failure="$failure" 'NF && $0 != failure { print "open\t" $0 "\tas last reported" }' \
    <<<"$previous"
}

readable=true
if ! problems >"$tmp/rows" 2>"$tmp/error"; then
  readable=false
  unreadable >"$tmp/rows"
fi

awk -F'\t' '$1 != "cleared" { print $2 "\t" $3 }' "$tmp/rows" >"$tmp/state"
count() { awk -F'\t' -v status="$1" '$1 == status { n++ } END { print n + 0 }' "$tmp/rows"; }
new=$(count new)
cleared=$(count cleared)
open=$(($(wc -l <"$tmp/state")))

if ((new + cleared == 0)); then
  printf 'bin/alert: no change; %d problems open\n' "$open" >&2
  if [[ $readable == false ]]; then exit 1; fi
  exit 0
fi

{
  printf 'From: %s\n' "$ALERT_FROM"
  printf 'To: %s\n' "${ALERT_TO//,/, }"
  printf 'Subject: minnalavu health: %d open, %d new, %d cleared\n' "$open" "$new" "$cleared"
  printf 'Date: %s\n' "$(LC_ALL=C date -u '+%a, %d %b %Y %H:%M:%S +0000')"
  printf 'MIME-Version: 1.0\nContent-Type: text/plain; charset=utf-8\n'
  printf 'Content-Transfer-Encoding: 8bit\n\n'
  awk -F'\t' '
    function section(status, title) {
      shown = 0
      for (i = 1; i <= n; i++) {
        if (s[i] != status) continue
        if (!shown++) printf "%s\n", title
        printf "  %s %s%s\n", k[i], j[i], (d[i] == "" ? "" : ": " d[i])
      }
      if (shown) print ""
    }
    { n++; s[n] = $1; k[n] = $2; j[n] = $3; d[n] = $4 }
    END {
      section("new", "New problems:")
      section("cleared", "Cleared:")
      section("open", "Still open:")
      print "Details: the views in the health schema (central/README.md)."
    }' "$tmp/rows"
} >"$tmp/mail"

if [[ $apply == false ]]; then
  cat -- "$tmp/mail"
  printf 'bin/alert: dry run: nothing sent, state unchanged; add --apply to send\n' >&2
  if [[ $readable == false ]]; then exit 1; fi
  exit 0
fi

# curl reads the login from its config on a pipe, so the password is not on
# the command line. In a config file a quoted value escapes \ and ".
quoted() {
  local v=${1//\\/\\\\}
  printf '"%s"' "${v//\"/\\\"}"
}
curl_args=(--silent --show-error --max-time 60 --url "$ALERT_SMTP_URL"
  --mail-from "$ALERT_FROM" --upload-file "$tmp/mail" --crlf)
for r in "${to[@]}"; do curl_args+=(--mail-rcpt "$r"); done
if [[ $ALERT_SMTP_TLS == required ]]; then curl_args+=(--ssl-reqd); fi

if ! curl --config <(printf 'user = %s\n' "$(quoted "$ALERT_SMTP_USER:$ALERT_SMTP_PASSWORD")") \
  "${curl_args[@]}"; then
  printf 'bin/alert: sending failed; state unchanged, so the next run tries again\n' >&2
  exit 1
fi

cp -- "$tmp/state" "$state.new"
mv -- "$state.new" "$state"
printf 'bin/alert: sent: %d open, %d new, %d cleared\n' "$open" "$new" "$cleared" >&2
if [[ $readable == false ]]; then exit 1; fi

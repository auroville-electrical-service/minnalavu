@echo off
rem A collector opens no listening ports, so no Erlang distribution and no epmd.
rem Assigned, not defaulted, so a stray environment variable cannot turn it on.
rem
rem `install` is the exception: bin\alavi.bat refuses to install a service with
rem distribution off, as erlsrv services always run as a named node. The
rem service gets a short name, and vm.args.eex (-dist_listen false
rem -start_epmd false) keeps that node from listening or starting epmd.
if "%RELEASE_COMMAND%" == "install" (
  set RELEASE_DISTRIBUTION=sname
) else (
  set RELEASE_DISTRIBUTION=none
)

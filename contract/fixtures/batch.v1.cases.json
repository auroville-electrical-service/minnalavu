{
  "description": "Changes to batch.v1.basic.json. Each of cases breaks one rule of the batch schema (set value at path, or remove the field when delete is true); each of valid keeps the batch valid. Every side that validates batches must reject every case and accept every valid change.",
  "cases": [
    { "name": "value as a JSON number", "path": ["readings", 0, "value"], "value": 1234.56 },
    { "name": "value with an exponent", "path": ["readings", 0, "value"], "value": "1.2e3" },
    { "name": "value with a trailing point", "path": ["readings", 0, "value"], "value": "12." },
    { "name": "a missing reading field", "path": ["readings", 0, "unit"], "delete": true },
    { "name": "a missing top-level field", "path": ["backlog"], "delete": true },
    { "name": "missing missed_reads", "path": ["missed_reads"], "delete": true },
    { "name": "an unknown field", "path": ["net_energy"], "value": "0" },
    { "name": "a collector id in the body", "path": ["collector_id"], "value": "alavi-pilot-01" },
    { "name": "an unknown reading field", "path": ["readings", 0, "net"], "value": "0" },
    { "name": "an unknown unit", "path": ["readings", 0, "unit"], "value": "MWh" },
    { "name": "unit id 0", "path": ["readings", 0, "unit_id"], "value": 0 },
    { "name": "unit id 248", "path": ["readings", 0, "unit_id"], "value": 248 },
    { "name": "unit id as a string", "path": ["readings", 0, "unit_id"], "value": "1" },
    { "name": "a fractional unit id", "path": ["readings", 0, "unit_id"], "value": 1.5 },
    { "name": "port 0", "path": ["readings", 0, "endpoint", "port"], "value": 0 },
    { "name": "an empty host", "path": ["readings", 0, "endpoint", "host"], "value": "" },
    { "name": "an empty meter serial", "path": ["readings", 0, "meter_serial"], "value": "" },
    { "name": "a reading with no serial read", "path": ["readings", 0, "meter_serial"], "value": null },
    { "name": "a missing product code", "path": ["readings", 0, "product_code"], "delete": true },
    { "name": "an empty product code", "path": ["readings", 0, "product_code"], "value": "" },
    { "name": "a null product code", "path": ["readings", 0, "product_code"], "value": null },
    { "name": "a product code as a number", "path": ["readings", 0, "product_code"], "value": 445 },
    { "name": "a product code on a missed read", "path": ["missed_reads", 0, "product_code"], "value": "ELITE440-445" },
    { "name": "an empty missed-read serial", "path": ["missed_reads", 0, "meter_serial"], "value": "" },
    { "name": "a missing missed-read serial", "path": ["missed_reads", 0, "meter_serial"], "delete": true },
    { "name": "no raw words", "path": ["readings", 0, "raw_words"], "value": [] },
    { "name": "five raw words", "path": ["readings", 0, "raw_words"], "value": [0, 0, 0, 0, 0] },
    { "name": "a raw word above 0xFFFF", "path": ["readings", 0, "raw_words"], "value": [65536, 0] },
    { "name": "a negative raw word", "path": ["readings", 0, "raw_words"], "value": [-1, 0] },
    { "name": "schema version 2", "path": ["schema_version"], "value": 2 },
    { "name": "a batch id that is not a UUID", "path": ["batch_id"], "value": "batch-1" },
    { "name": "a timestamp that is not a date-time", "path": ["readings", 0, "timestamp"], "value": "2026-11-01 00:00" },
    { "name": "a timestamp without an offset", "path": ["readings", 0, "timestamp"], "value": "2026-11-01T00:00:00" },
    { "name": "a timestamp on a day that does not exist", "path": ["readings", 0, "timestamp"], "value": "2026-02-30T00:00:00Z" },
    { "name": "a leap second", "path": ["sent_at"], "value": "2026-12-31T23:59:60Z" },
    { "name": "hour 24", "path": ["sent_at"], "value": "2026-11-01T24:00:00Z" },
    { "name": "an offset without a colon", "path": ["sent_at"], "value": "2026-11-01T00:05:00+0530" },
    { "name": "a UUID without hyphens", "path": ["batch_id"], "value": "0b6f8d2e5c1a4e7b9a3d2f4c6e8a0b1c" },
    { "name": "an unknown clock source", "path": ["clock", "source"], "value": "gps" },
    { "name": "readings that are not a list", "path": ["readings"], "value": {} },
    { "name": "a negative backlog count", "path": ["backlog", "events"], "value": -1 },
    { "name": "a backlog count above 2^53 - 1", "path": ["backlog", "bytes"], "value": 9007199254740992 },
    { "name": "a buffer capacity above 2^53 - 1", "path": ["backlog", "max_bytes"], "value": 9007199254740992 },
    { "name": "a zero buffer capacity", "path": ["backlog", "max_bytes"], "value": 0 },
    { "name": "an unknown backlog field", "path": ["backlog", "free"], "value": 0 },
    { "name": "an unknown missed-read reason", "path": ["missed_reads", 0, "reason"], "value": "gone" },
    { "name": "exception code 0", "path": ["missed_reads", 0, "exception_code"], "value": 0 },
    { "name": "a missing exception code", "path": ["missed_reads", 0, "exception_code"], "delete": true },
    { "name": "a negative attempt count", "path": ["missed_reads", 0, "attempts"], "value": -1 },
    { "name": "a detail longer than 200 characters", "path": ["missed_reads", 1, "detail"], "value": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" },
    { "name": "missed raw words as a string", "path": ["missed_reads", 0, "raw_words"], "value": "0" },
    { "name": "a missed read with a value", "path": ["missed_reads", 0, "value"], "value": "1.0" }
  ],
  "valid": [
    { "name": "no readings and no missed reads", "changes": [{ "path": ["readings"], "value": [] }, { "path": ["missed_reads"], "value": [] }] },
    { "name": "a clock never synced", "changes": [{ "path": ["clock"], "value": { "source": "unsynced", "last_sync_at": null } }] },
    { "name": "an empty backlog", "changes": [{ "path": ["backlog", "oldest"], "value": null }] },
    { "name": "a timestamp with an offset and microseconds", "changes": [{ "path": ["readings", 0, "timestamp"], "value": "2026-11-01T05:30:00.123456+05:30" }] },
    { "name": "missed raw words that did not decode", "changes": [{ "path": ["missed_reads", 0, "raw_words"], "value": [65535, 65535] }, { "path": ["missed_reads", 0, "reason"], "value": "decode" }] },
    { "name": "a meter that does not match its profile", "changes": [{ "path": ["missed_reads", 0, "reason"], "value": "profile_mismatch" }, { "path": ["missed_reads", 0, "exception_code"], "value": null }, { "path": ["missed_reads", 0, "detail"], "value": "product code \"ELITE440-444\", expected one of ELITE440-445, ELITE440-446" }, { "path": ["missed_reads", 0, "attempts"], "value": 0 }] },
    { "name": "a detail of exactly 200 characters", "changes": [{ "path": ["missed_reads", 1, "detail"], "value": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" }] },
    { "name": "an integer written with a zero fraction", "changes": [{ "path": ["readings", 0, "endpoint", "port"], "value": 502.0 }] },
    { "name": "a timestamp in lower case", "changes": [{ "path": ["sent_at"], "value": "2026-11-01t00:05:00z" }] },
    { "name": "a missed read with no serial read", "changes": [{ "path": ["missed_reads", 1, "meter_serial"], "value": null }] },
    { "name": "a value with many digits", "changes": [{ "path": ["readings", 0, "value"], "value": "-123456789012345678901234.123456789012" }] }
  ]
}
